      "index": 0,
      "file": "theory-specimens/library-ui-buttons-button-role-0.png",
      "sha256": "d9b0e2306b83dadf0eb6c5b5842b23b0a14f9698a4f010f3c29df5e652c10607",
      "source": "assets/specimens/ui-buttons.html",
      "sourceHash": "1f21fdf2722d3ab492a72a70609182a917edf4e91bae3b4402f61596a774b609",
      "state": {
        "width": 592,
        "height": 280.453125,
        "text": "Hành động chính\nBắt đầu\nDùng khi: Việc tiếp theo quan trọng nhất trong một nhóm.\nTránh dùng: Không đặt nhiều hành động chính cạnh nhau; không dùng để đánh dấu trang hiện tại.",
        "scrollWidth": 590,
        "clientWidth": 590,
        "images": []
      }
    },
    {
      "id": "library:ui-buttons",
      "kind": "detail",
      "role": "button-role",
      "title": "Vai trò nút và các trạng thái",
      "selector": "section.ui261-type",
      "index": 1,
      "file": "theory-specimens/library-ui-buttons-button-role-1.png",
      "sha256": "478689206c69f015b8ff44acb67ce4a653ea53ec47315252b5495731e2dc69fd",
      "source": "assets/specimens/ui-buttons.html",
      "sourceHash": "1f21fdf2722d3ab492a72a70609182a917edf4e91bae3b4402f61596a774b609",
      "state": {
        "width": 592,
        "height": 280.453125,
        "text": "Hành động phụ\nXem chi tiết\nDùng khi: Lựa chọn hỗ trợ bên cạnh hành động chính, như xem chi tiết hoặc quay lại.\nTránh dùng: Không dùng khi cần nổi bật hơn việc chính.",
        "scrollWidth": 590,
        "clientWidth": 590,
        "images": []
      }
    },
    {
      "id": "library:ui-buttons",
      "kind": "detail",
      "role": "button-role",
      "title": "Vai trò nút và các trạng thái",
      "selector": "section.ui261-type",
      "index": 2,
      "file": "theory-specimens/library-ui-buttons-button-role-2.png",
      "sha256": "0bda851729cd9b8888db674a4fd8a9fbae786d22ea3d0e4b1d5fb1be2cc54ef6",
      "source": "assets/specimens/ui-buttons.html",
      "sourceHash": "1f21fdf2722d3ab492a72a70609182a917edf4e91bae3b4402f61596a774b609",
      "state": {
        "width": 592,
        "height": 310.140625,
        "text": "Hành động cần chú ý\nTái sử dụng\nDùng khi: Thao tác ưu tiên riêng của ngữ cảnh, như tái sử dụng tài sản trong Thư viện.\nTránh dùng: Không tô vàng mọi nút; không dùng vàng để ngụ ý hoàn thành.",
        "scrollWidth": 590,
        "clientWidth": 590,
        "images": []
      }
    },
    {
      "id": "library:ui-buttons",
      "kind": "detail",
      "role": "button-role",
      "title": "Vai trò nút và các trạng thái",
      "selector": "section.ui261-type",
      "index": 3,
      "file": "theory-specimens/library-ui-buttons-button-role-3.png",
      "sha256": "9bc94e2b38a5e3001a4e7bc81078f7a6d57cab8ddf659ea564fdb8c11f189fb1",
      "source": "assets/specimens/ui-buttons.html",
      "sourceHash": "1f21fdf2722d3ab492a72a70609182a917edf4e91bae3b4402f61596a774b609",
      "state": {
        "width": 592,
        "height": 342.828125,
        "text": "Quan trọng / đang chọn\nĐang chọn\nDùng khi: Lựa chọn cần giữ dấu nhận biết. Mẫu bật/tắt dùng nền sapphire, chữ trắng và gạch vàng; trang hiện tại phải dùng thuộc tính riêng.\nTránh dùng: Không đánh dấu nhiều trang cùng đang ở. Với hành động, chỉ dùng khi có lý do ưu tiên rõ.",
        "scrollWidth": 590,
        "clientWidth": 590,
        "images": []
      }
    },
    {
      "id": "library:ui-buttons",
      "kind": "detail",
      "role": "button-role",
      "title": "Vai trò nút và các trạng thái",
      "selector": "section.ui261-type",
      "index": 4,
      "file": "theory-specimens/library-ui-buttons-button-role-4.png",
      "sha256": "80f83e5bbf35eec5020390b181b7d481086bcdc35343b334992db8d725cf780b",
      "source": "assets/specimens/ui-buttons.html",
      "sourceHash": "1f21fdf2722d3ab492a72a70609182a917edf4e91bae3b4402f61596a774b609",
      "state": {
        "width": 592,
        "height": 287.75,
        "text": "Liên kết nhẹ\nĐọc hướng dẫn\nDùng khi: Mở một đích hỗ trợ trong đoạn văn, khi không cần khung nút.\nTránh dùng: Không dùng liên kết để chạy thao tác; không bỏ gạch dưới làm mất dấu nhận biết.",
        "scrollWidth": 590,
        "clientWidth": 590,
        "images": []
      }
    },
    {
      "id": "library:ui-buttons",
      "kind": "detail",
      "role": "button-role",
      "title": "Vai trò nút và các trạng thái",
      "selector": "section.ui261-type",
      "index": 5,
      "file": "theory-specimens/library-ui-buttons-button-role-5.png",
      "sha256": "5e9089cce11461368db09e8a9f855980ac4b8e11f1a314d3a44f5860822b2126",
      "source": "assets/specimens/ui-buttons.html",
      "sourceHash": "1f21fdf2722d3ab492a72a70609182a917edf4e91bae3b4402f61596a774b609",
      "state": {
        "width": 592,
        "height": 385.515625,
        "text": "Trạng thái không khả dụng\nTiếp tục\n\nVí dụ điều kiện chưa đáp ứng: chưa chọn tệp. Nút này chỉ minh họa trạng thái khóa; trang không có chức năng gửi tệp.\n\nDùng khi: Chỉ khóa khi có điều kiện chưa đáp ứng và giải thích điều kiện cạnh nút.\nTránh dùng: Không dùng màu nhạt để giả trạng thái đang chọn; không để người đọc đoán lý do.",
        "scrollWidth": 590,
        "clientWidth": 590,
        "images": []
      }
    },
